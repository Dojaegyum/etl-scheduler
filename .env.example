# Canvas (myetl.snu.ac.kr) — 설정 → 승인된 통합 → 새 액세스 토큰
CANVAS_PRIVATE_TOKEN=
CANVAS_BASE_URL=https://myetl.snu.ac.kr

# Google OAuth 데스크톱 클라이언트 (docs/SETUP.md 3단계)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# `pnpm auth` 실행 결과로 얻음 (docs/SETUP.md 4단계)
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# 알림 시각(분, 쉼표로 여러 개). 기본 1440 = 하루 전
REMINDER_MINUTES=1440
